<?xml version="1.0"?>
<robot name="mini_arm_ros2" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="scale" default="2.5" />
  <xacro:include filename="mini_arm.xacro" />

  <link name="world"/>
  <xacro:mini_arm parent="world" prefix="" scale="$(arg scale)">
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:mini_arm>

  <xacro:mini_arm_ros2_control name="mini_arm_control" prefix="" />
</robot>
