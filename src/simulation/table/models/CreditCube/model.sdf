<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="credit_cube">
    <static>false</static>
    <link name="link">
      <inertial>
        <mass>0.0625</mass>
        <pose>0.01905 0.01905 0.01905 0 0 0</pose>
        <inertia>
          <ixx>3.025e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>3.025e-05</iyy>
          <iyz>0</iyz>
          <izz>3.025e-05</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0.0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/CreditCube.stl</uri>
            <scale>0.5 0.5 0.5</scale>
          </mesh>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>meshes/CreditCube.stl</uri>
            <scale>0.5 0.5 0.5</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.5 0.0 0.0 1</ambient>
          <diffuse>0.8 0.0 0.0 1</diffuse>
          <specular>0.9 0.4 0.4 1</specular>
        </material>
      </visual>
      <sensor name="credit_cube_contact" type="contact">
        <contact>
          <collision>collision</collision>
        </contact>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>
    <plugin filename="ignition-gazebo-contact-system" name="gz::sim::systems::Contact"/>
  </model>
</sdf>
