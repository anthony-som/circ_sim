<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="security_camera_unit">
    <static>true</static>
    <link name="base_link">
      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.16 0.16 0.20</size>
          </box>
        </geometry>
      </collision>
      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.16 0.16 0.20</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>

      <light name="camera_spotlight" type="spot">
        <pose>0.10 0 0.10 0 0 0</pose>
        <cast_shadows>true</cast_shadows>
        <diffuse>0.95 0.95 0.90 1</diffuse>
        <specular>0.10 0.10 0.10 1</specular>
        <attenuation>
          <range>8.0</range>
          <constant>0.9</constant>
          <linear>0.05</linear>
          <quadratic>0.01</quadratic>
        </attenuation>
        <direction>1 0 -0.2</direction>
        <spot>
          <inner_angle>0.25</inner_angle>
          <outer_angle>0.50</outer_angle>
          <falloff>0.8</falloff>
        </spot>
      </light>
    </link>
  </model>
</sdf>
