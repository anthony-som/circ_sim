<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="transport_box">
    <static>false</static>
    <link name="link">
      <inertial>
        <mass>1.0</mass>
        <pose>0.1524 0.1524 0.1143 0 0 0</pose>
        <inertia>
          <ixx>0.0121</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0121</iyy>
          <iyz>0</iyz>
          <izz>0.0155</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0.0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/TransportBox.stl</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>meshes/TransportBox.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.5 0.0 0.0 1</ambient>
          <diffuse>0.8 0.0 0.0 1</diffuse>
          <specular>0.9 0.4 0.4 1</specular>
        </material>
