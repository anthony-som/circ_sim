<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="transport_box">
    <static>false</static>
    <link name="link">
      <inertial>
        <mass>0.4</mass>
        <pose>0.06096 0.06096 0.04572 0 0 0</pose>
        <inertia>
          <ixx>7.68e-04</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>7.68e-04</iyy>
          <iyz>0</iyz>
          <izz>9.6e-04</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0.0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>meshes/TransportBox.stl</uri>
            <scale>0.4 0.4 0.4</scale>
