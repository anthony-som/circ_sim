      <sensor name="transport_box_contact" type="contact">
        <contact>
          <collision>collision</collision>
        </contact>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>
    <plugin filename="ignition-gazebo-contact-system" name="gz::sim::systems::Contact"/>
  </model>
</sdf>
