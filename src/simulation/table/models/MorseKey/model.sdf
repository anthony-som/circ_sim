<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="morse_key">
    <static>true</static>
    <link name="link">
      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.24 0.12 0.06</size>
          </box>
        </geometry>
      </collision>
      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.24 0.12 0.06</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.22 0.12 1</ambient>
          <diffuse>0.38 0.28 0.16 1</diffuse>
        </material>
      </visual>

      <collision name="key_collision">
        <pose>0.06 0 0.05 0 0 0</pose>
        <geometry>
          <box>
            <size>0.14 0.05 0.02</size>
          </box>
        </geometry>
      </collision>
      <visual name="key_visual">
        <pose>0.06 0 0.05 0 0 0</pose>
        <geometry>
          <box>
            <size>0.14 0.05 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.18 0.18 0.18 1</ambient>
          <diffuse>0.24 0.24 0.24 1</diffuse>
        </material>
      </visual>

      <sensor name="morse_key_contact" type="contact">
        <contact>
          <collision>key_collision</collision>
        </contact>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>
    <plugin filename="ignition-gazebo-contact-system" name="gz::sim::systems::Contact"/>
  </model>
</sdf>
