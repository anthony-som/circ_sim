<sdf version='1.9'>
  <world name='empty'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name='gz::sim::systems::Physics' filename='ignition-gazebo-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='ignition-gazebo-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='ignition-gazebo-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='ignition-gazebo-contact-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='ignition-gazebo-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.85 0.88 0.92 1</background>
      <shadows>true</shadows>
    </scene>

    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.74 0.66 0.50 1</ambient>
            <diffuse>0.78 0.70 0.54 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <light name='sun' type='directional'>
      <pose>0 0 20 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.0</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.9</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- Rover course checkpoints -->

    <!-- Checkpoint 1: credit tap pickup -->
    <include>
      <uri>model://Panel</uri>
      <name>ButtonPanel</name>
      <pose>0.80 -0.30 0.0 0 0 0</pose>
    </include>

    <!-- Checkpoint 0: start area credit cube -->
    <include>
      <uri>model://CreditCube</uri>
      <name>CreditCube</name>
      <pose>-3.40 -1.30 0.0 0 0 0</pose>
    </include>

    <!-- Start/finish marker: transport box must return here -->
    <include>
      <uri>model://TransportBox</uri>
      <name>TransportBox</name>
      <pose>-3.90 -1.30 0.0 0 0 0</pose>
    </include>

    <!-- Checkpoint 2: dispensed item collection zone -->
    <include>
      <uri>model://CreditCube</uri>
      <name>DispenseItem_1</name>
      <pose>2.10 1.20 0.0 0 0 0</pose>
    </include>

    <include>
      <uri>model://CreditCube</uri>
      <name>DispenseItem_2</name>
      <pose>2.45 1.20 0.0 0 0 0</pose>
    </include>

    <include>
      <uri>model://CreditCube</uri>
      <name>DispenseItem_3</name>
      <pose>2.80 1.20 0.0 0 0 0</pose>
    </include>

    <!-- Checkpoint 3: service panel at end of course -->
    <include>
      <uri>model://Panel</uri>
      <name>ServicePanel</name>
      <pose>4.00 -0.80 0.0 0 0 3.14159</pose>
    </include>

    <!-- Flat-plane course: no terrain obstacles -->
  </world>
</sdf>
